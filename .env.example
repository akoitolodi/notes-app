# AI backend configuration — copy to .env (never commit .env)
# Required only when using Local / Termux Server mode (not needed for Direct API mode)
FREELLMAPI_API_KEY=

# Base URL of the OpenAI-compatible API
# Local freellmapi proxy: http://127.0.0.1:3001/v1
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1

# Model id used for scans (use "auto" to let the proxy route)
FREELLMAPI_MODEL=auto

# Port and host for the local Express server
# Defaults to 127.0.0.1:8080 (loopback-only for security). Set HOST=0.0.0.0 for LAN access.
# PORT=8080
# HOST=127.0.0.1
# CORS_ORIGIN=
